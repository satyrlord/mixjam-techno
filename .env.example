# Copy this file to .env.local (gitignored) and set your own paths.
# One KEY="value" per line. An environment variable of the same name overrides
# the file. A relative path is read from the repository root. Forward slashes
# work on Windows.

# The folder where finished songs and their renders go for the owner to hear.
SONG_FOLDER="D:/music/MixJam songs"

# The sample libraries that songs use, up to 9: SAMPLES_FOLDER_1 to SAMPLES_FOLDER_9.
# Leave out the numbers you do not need.
SAMPLES_FOLDER_1="D:/samples/library one"
SAMPLES_FOLDER_2="D:/samples/library two"

# The sample index that tools/song/samples.py writes and searches. Optional.
SAMPLE_INDEX="local-data/samples/index.tsv"

# The folder with the reference album's mastered WAV files (tools/song/master.py --album).
REFERENCE_ALBUM_FOLDER="D:/music/reference album"

# The private artist profile that the song-review skill reads: style, rules, targets.
# Keep it in local-data/ (gitignored).
ARTIST_PROFILE="local-data/song-review/artist-profile.md"

# The reference profile (JSON) that tools/song/master.py writes with --album and that
# master.py and measure.py read. Optional: without it, reference.json beside ARTIST_PROFILE.
REFERENCE_PROFILE="local-data/song-review/reference.json"
